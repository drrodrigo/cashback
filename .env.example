# O endereco do projeto Supabase. NAO e segredo: ele vai no pacote do navegador.
VITE_SUPABASE_URL=

# A chave publica (a `publishable` do painel, ou a `anon` antiga). Tambem vai no
# navegador de proposito -- ela so autoriza o papel `anon`, e a gaveta `cash` nao
# da nem `usage` para ele. Quem autoriza de verdade e o login da pessoa.
#
# 🔴 Pegue o valor da TELA do Supabase, nunca de um chat: aplicativo de mensagem
# mascara texto com cara de chave, e o que se copia e a mascara.
VITE_SUPABASE_ANON_KEY=
